// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`systemd unit generation > renders the unit (snapshot) 1`] = `
"# Generated by "agent-orchestrator service install". Changes are overwritten by the next install.
# Stop contract: SIGTERM drains (drain timeout), then cancels all runs (cancel timeout);
# TimeoutStopSec = drain 10m + cancel 2m + grace 30s + buffer 1m.
# For planned stops/updates run "agent-orchestrator drain --wait" first (see docs/operations.md).
[Unit]
Description=Agent Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-orchestrator
Group=agent-orchestrator
ExecStart=/usr/bin/node /usr/lib/node_modules/agent-orchestrator/dist/cli/main.js start --config-dir /etc/agent-orchestrator --data-dir /var/lib/agent-orchestrator --drain-timeout 10m --cancel-timeout 2m
WorkingDirectory=/var/lib/agent-orchestrator
EnvironmentFile=-/etc/default/agent-orchestrator
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=810
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
"
`;
