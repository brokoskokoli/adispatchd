// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`systemd unit generation > renders the unit (snapshot) 1`] = `
"# Generated by "adispatch service install". Changes are overwritten by the next install.
# Stop contract: SIGTERM drains (drain timeout), then cancels all runs (cancel timeout);
# TimeoutStopSec = drain 10m + cancel 2m + grace margin 30s + buffer 1m.
# For planned stops/updates run "adispatch drain --wait" first (see docs/operations.md).
[Unit]
Description=Agent Dispatch Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adispatchd
Group=adispatchd
ExecStart=/usr/bin/node /usr/lib/node_modules/adispatchd/dist/cli/main.js start --config-dir /etc/adispatchd --data-dir /var/lib/adispatchd --drain-timeout 10m --cancel-timeout 2m
WorkingDirectory=/var/lib/adispatchd
EnvironmentFile=-/etc/default/adispatchd
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=810
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
"
`;

exports[`systemd unit generation > renders the unit of a hub (snapshot): \`hub start\`, KillMode=mixed, same stop contract 1`] = `
"# Generated by "adispatch service install". Changes are overwritten by the next install.
# Stop contract: SIGTERM drains (drain timeout), then cancels all runs (cancel timeout);
# TimeoutStopSec = drain 10m + cancel 2m + grace margin 30s + buffer 1m.
# Hub: SIGTERM goes to the hub only (KillMode=mixed); it hands one SIGTERM to every workspace, which drain and cancel in parallel.
# For planned stops/updates run "adispatch hub drain-all --wait" first (see docs/operations.md).
[Unit]
Description=Agent Dispatch Daemon (hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adispatchd
Group=adispatchd
ExecStart=/usr/bin/node /usr/lib/node_modules/adispatchd/dist/cli/main.js hub start --config-dir /etc/adispatchd-hub --data-dir /var/lib/adispatchd-hub/hub --drain-timeout 10m --cancel-timeout 2m
WorkingDirectory=/var/lib/adispatchd-hub/hub
EnvironmentFile=-/etc/default/adispatchd-hub
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=810
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
"
`;
