{
  "name": "adispatchd",
  "version": "0.4.0",
  "description": "Agent Dispatch Daemon – configuration-driven dispatcher and orchestrator for shell processes and AI agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brokoskokoli/adispatchd.git"
  },
  "homepage": "https://brokoskokoli.github.io/adispatchd/",
  "bugs": {
    "url": "https://github.com/brokoskokoli/adispatchd/issues"
  },
  "bin": {
    "adispatch": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "!dist/**/testing/",
    "examples/",
    "docs/api.md",
    "docs/configuration-reference.md",
    "docs/operations.md",
    "docs/worker-protocol.md",
    "docs/cron-semantics.md",
    "docs/manual-tests/",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit && vitest run",
    "dev": "tsx src/cli/main.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "prepack": "rm -rf dist && npm run build",
    "test:pack": "ADISPATCH_PACK_TEST=1 vitest run src/cli/pack.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "brokoskokoli",
  "keywords": [
    "ai-agents",
    "ai-agent",
    "agent-orchestration",
    "orchestrator",
    "llm",
    "coding-agent",
    "dispatcher",
    "daemon",
    "task-runner",
    "github",
    "github-issues",
    "github-projects",
    "github-app",
    "automation",
    "workflow",
    "workflow-automation",
    "scheduler",
    "cron",
    "shell",
    "docker",
    "podman",
    "systemd",
    "self-hosted",
    "cli",
    "yaml"
  ],
  "publishConfig": {
    "access": "public"
  }
}
